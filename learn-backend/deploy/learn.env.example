# /etc/pipeline-learn.env  (root:pipeline-learn, mode 640). Names and shapes only; fill the values on the server.
# The app listens on loopback only; nginx is the only way in.
SERVER_PORT=8081
SERVER_ADDRESS=127.0.0.1

# The role created by db-roles.sql. The database is the CRM's; the app only uses its schema `learn`.
DB_URL=jdbc:postgresql://localhost:5432/pipeline_crm
DB_USERNAME=learn_app
DB_PASSWORD=<the learn_password given to db-roles.sql>

# The CRM's own database role (V5 gives it rights on the bridge). Leave as is unless the CRM uses another login.
LEARN_CRM_DB_ROLE=pipeline_user

# Course material and shared logins live OUTSIDE the release folders so a deploy never touches them.
LEARN_CONTENT_DIR=/var/lib/pipeline-learn/content
LEARN_SECRETS_DIR=/var/lib/pipeline-learn/secrets

# The site is served over HTTPS: cookies must be marked Secure.
SESSION_COOKIE_SECURE=true
